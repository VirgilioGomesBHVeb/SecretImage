[Unit]
Description=SecretImage 2.0 Flask application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/SecretImage_2.0
Environment="SECRETIMAGE_HOST=127.0.0.1"
Environment="SECRETIMAGE_PORT=5000"
Environment="SECRETIMAGE_DEBUG=0"
Environment="SECRETIMAGE_SESSION_KEY=CHANGE-ME"
ExecStart=/opt/SecretImage_2.0/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
